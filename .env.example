# Vastu Ready — environment
# The app runs fully in demo mode with NONE of these set (mock AI, local state,
# seeded Raleigh data). Add them to enable Supabase + a real AI provider.

# Public app URL (used for metadata / OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — publishable/anon key only on the client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefixed NEXT_PUBLIC_, never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=mock
AI_API_KEY=

# RentCast — real, licensed listing facts for the feed (server-only).
# When RENTCAST_API_KEY is set, the catalog is pulled live from RentCast instead
# of the fictional demo homes. Get a free key (~50 requests/month) at
# https://app.rentcast.io/app/api — results are cached in memory, so a whole
# feed costs one request. Vastu orientation is NEVER fabricated: it stays
# "needs verification" until confirmed per home.
RENTCAST_API_KEY=
# Optional market + tuning (defaults shown):
RENTCAST_MARKET_CITY=Raleigh
RENTCAST_MARKET_STATE=NC
RENTCAST_LISTING_LIMIT=12
RENTCAST_CACHE_HOURS=6

# MLS (Trestle / CoreLogic) — server-only. Set after MLS approval + e-signed
# data license. These enable the live hot-sheet feed; never the agent's password.
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=
# Optional overrides (defaults are the Trestle prod endpoints):
TRESTLE_TOKEN_URL=
TRESTLE_API_BASE=

# Automated floor-plan reading (Layer 3 auto-suggest) — server-only. When set,
# a configured vision model pre-suggests room positions on an uploaded plan
# (still unconfirmed until a person confirms). Unset = honest manual placement.
VISION_API_KEY=
VISION_MODEL=

# Cross-device persistence: with the Supabase keys above set AND a signed-in
# user, app state mirrors to the owner-scoped public.user_state table
# (apply supabase/migrations/0002_user_state.sql). No secrets are persisted.
