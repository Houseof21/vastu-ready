# Vastu Ready — environment
# The app runs fully in demo mode with NONE of these set (mock AI, local state,
# seeded Raleigh data). Add them to enable Supabase + a real AI provider.

# Public app URL (used for metadata / OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — publishable/anon key only on the client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefixed NEXT_PUBLIC_, never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=mock
AI_API_KEY=
